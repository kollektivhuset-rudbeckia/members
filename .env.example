# Kopiera till .env och fyll i. Committa aldrig den riktiga .env.
#
# Vill du bara se hur det ser ut? Då behöver du inte den här filen alls —
# se "Prova på" i README, eller kör:
#
#   docker compose -f docker-compose.demo.yml up

# --- Krävs -------------------------------------------------------------------

# OAuth-klienten som loggar in folk. Skapas i Google Cloud Console under
# APIs & Services → Credentials → OAuth client ID → Web application.
# Auktoriserad redirect-URI måste vara exakt BASE_URL + /oauth2/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Den publika adressen. Måste stämma, för den avgör dels vart Google skickar
# tillbaka webbläsaren efter inloggning, dels om sessionskakan sätts som
# Secure (den blir det när adressen är https://).
BASE_URL=https://medlemmar.rudbeckia.nu

# Workspace-domänen. Inloggningar från alla andra domäner nekas — och det är
# den kontrollen som står mellan registret och alla Google-konton i världen,
# så lämna den inte tom.
GOOGLE_HOSTED_DOMAIN=rudbeckia.nu

# --- Synkroniseringen mot Google ---------------------------------------------
# Utan de här två fungerar registret precis som vanligt, men ingenting skrivs
# till grupperna, kontakterna eller kalkylarket — och varje sida säger det.

# Tjänstekontots nyckelfil. Läs README:n för hela uppsättningen: nyckeln ska
# ha domänvid delegering (domain-wide delegation) med de scopes som står där.
GOOGLE_SERVICE_ACCOUNT_FILE=/secrets/service-account.json
# Alternativt, för en deploy som helst skickar hemligheter som miljövariabler.
# Antingen ren JSON eller base64-kodad.
# GOOGLE_SERVICE_ACCOUNT_JSON=

# Den Workspace-administratör tjänstekontot agerar som när det hanterar
# grupper. Att ändra en grupp är en administratörsåtgärd — ett tjänstekonto
# kan inte göra det som sig självt, hur många scopes det än har.
GOOGLE_ADMIN_SUBJECT=admin@rudbeckia.nu

# --- Vilka konton som kommer in ----------------------------------------------
# Tre roller, tre delade brevlådor. Kommaseparera om flera adresser ska ha
# samma roll. Allt utanför de här listorna nekas, oavsett domän.

ACCOUNT_INTAKE=ny@rudbeckia.nu
ACCOUNT_CASHIER=ekonomi@rudbeckia.nu
ACCOUNT_BOARD=styrelsen@rudbeckia.nu

# Vilka roller som får pricka av en betalning. Huset ville att det bara skulle
# vara ekonomi — de är de som har bankkontot framför sig — så det är
# standard. Vill styrelsen kunna rätta en felprickning: cashier,board
PAYMENT_ROLES=cashier

# --- Frivilligt --------------------------------------------------------------

# Signerar sessionskakorna. Utan den görs en ny hemlighet vid varje start,
# vilket är säkert men loggar ut alla vid varje deploy.
SESSION_SECRET=

# Hur länge en inloggning håller. Kontona är delade brevlådor, så det är
# medvetet kort.
SESSION_HOURS=12

# debug, info, warn eller error.
LOG_LEVEL=info

# Läs klientens IP ur X-Forwarded-For. Rätt bakom en proxy, fel utan.
TRUST_PROXY=true

# Var registret och konfigurationen ligger.
# DB_PATH=/data/members.db
# CONFIG_PATH=/config.yaml
# LISTEN_ADDR=:8080

# Demoläge: påhittade medlemmar, ingen Google, och en inloggningssida som
# delar ut roller på begäran. Aldrig i skarp drift.
# DEMO=false
